# === Wiser repo .gitignore ===
# Track-list model (D's call, 07 Jul 2026): only kb/ (runtime KB data, single
# source of truth for the backend), app/ (the actual buildable Next.js +
# FastAPI app), and Wiser_PRD_MVP.md are committed. Everything else - task
# log, context.md, design refs, past work/ - is local-only and stays out of git.
#
# DEPLOY CONSTRAINT (19 Jul 2026): Vercel's Root Directory is set to
# app/frontend, so the build sandbox contains that subtree ONLY. Any file the
# frontend reads at build time must live inside app/frontend/ - committing it
# at the repo root is not enough, the build cannot see it. Being tracked by git
# and being visible to the build are two different things.

# 1) Ignore everything at the top level by default...
/*

# 2) ...except the paths we actually want to track.
!/kb/
!/app/
!/.gitignore
!/Wiser_PRD_MVP.md

# --- Below: still enforced *inside* kb/ and app/ once app/ exists ---

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Secrets / env files
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# Node / Next.js (app/frontend)
node_modules/
.next/
out/
build/
dist/
coverage/
.pnp.js
.pnp.cjs
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts
.vercel

# Python / FastAPI (app/backend)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases (local dev)
*.sqlite3
*.db

# Logs
*.log

# Local upload/tmp dirs
/app/backend/tmp/
/app/**/uploads/

# Local backup of the pre-crop card originals (large binaries, not served)
/app/frontend/public/cards-originals/
