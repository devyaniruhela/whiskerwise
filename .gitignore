# === Wiser repo .gitignore ===
# Track-list model (D's call, 07 Jul 2026): only kb/ (runtime KB data, single
# source of truth for the backend) and app/ (the actual buildable Next.js +
# FastAPI app) are committed. Everything else in this folder — planning docs,
# PRD, task log, design refs, past work/ — is local-only and stays out of git.

# 1) Ignore everything at the top level by default...
/*

# 2) ...except the paths we actually want to track.
!/kb/
!/app/
!/.gitignore

# --- Below: still enforced *inside* kb/ and app/ once app/ exists ---

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Secrets / env files
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# Node / Next.js (app/frontend)
node_modules/
.next/
out/
build/
dist/
coverage/
.pnp.js
.pnp.cjs
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts
.vercel

# Python / FastAPI (app/backend)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases (local dev)
*.sqlite3
*.db

# Logs
*.log

# Local upload/tmp dirs
/app/backend/tmp/
/app/**/uploads/
